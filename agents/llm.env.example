# 环境变量模板（复制为 llm.env 后填入真实值；llm.env 已被 .gitignore 挡在仓库外）
# 支持任意 OpenAI 兼容端点（DeepSeek / vLLM / Ollama 均可，需支持工具调用）

export LLM_BASE_URL="https://你的端点/v1"
export LLM_API_KEY="你的密钥"

# 默认模型
export LLM_MODEL="模型名"

# 按角色覆盖（可选；注意：所选模型必须支持工具调用/function calling）
export LLM_MODEL_HOST="模型名"          # 主持
export LLM_MODEL_STATUTE="模型名"       # 条文核查
export LLM_MODEL_ADVISOR="模型名"       # 落地顾问
export LLM_MODEL_CHALLENGER="模型名"    # 风险审查
export LLM_MODEL_ARBITER="模型名"       # 仲裁（建议用最强且支持工具调用的模型）
export LLM_MODEL_PERSONA="模型名"       # 用户代言人
export LLM_MODEL_RESEARCHER="模型名"    # 政策原文检索官

# 联网检索（政策原文检索官用；博查AI的 web-search 接口）
export SEARCH_API_KEY="你的博查密钥"

# 主持(Leader)对外的公网固定隧道地址（内网穿透保留TCP地址），格式 域名:端口
export AGENT_TUNNEL="xxx.tcp.vip.cpolar.cn:12345"
# 可选：某位伙伴单独走公网隧道（默认 nip.io 回环，仅同机Leader可达）
# export AGENT_TUNNEL_STATUTE="yyy.tcp.vip.cpolar.cn:12346"

# 可选：企业杀毒软件做HTTPS拦截时，把其根证书并入信任束后指定
# export SSL_CERT_FILE="E:/CTF/wit/agents/ca_bundle.pem"
